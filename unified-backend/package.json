{
  "name": "stocksense-unified-backend",
  "version": "1.0.0",
  "description": "StockSense Hackathon Unified Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "docker compose exec db psql -U postgres -d stocksense -f /docker-entrypoint-initdb.d/024_seeds_seed.sql",
    "test": "tsx tests/integration.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.13.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.10.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
