generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(uuid())
  name                 String
  email                String             @unique
  phone                String?
  passwordHash         String             @map("password_hash")
  role                 String             @default("WAREHOUSE_WORKER")
  assignedWarehouseIds String             @default("") @map("assigned_warehouse_ids")
  isActive             Boolean            @default(true) @map("is_active")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  operationsCreated    StockOperation[]   @relation("OperationCreator")
  operationsApproved   StockOperation[]   @relation("OperationApprover")
  operationsAssigned   StockOperation[]   @relation("OperationAssigned")
  reservations         StockReservation[]
  auditLogs            AuditLog[]

  @@map("users")
}

model Warehouse {
  id           String        @id @default(uuid())
  name         String
  code         String        @unique
  address      String?
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  locations    Location[]
  reorderRules ReorderRule[]
  alerts       Alert[]

  @@map("warehouses")
}

model Location {
  id               String             @id @default(uuid())
  warehouseId      String             @map("warehouse_id")
  parentLocationId String?            @map("parent_location_id")
  name             String
  barcode          String?            @unique
  locationType     String             @default("internal") @map("location_type")
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")
  warehouse        Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  parentLocation   Location?          @relation("LocationHierarchy", fields: [parentLocationId], references: [id])
  childLocations   Location[]         @relation("LocationHierarchy")
  sourceMoves      StockMove[]        @relation("MoveSource")
  destMoves        StockMove[]        @relation("MoveDest")
  sourceOperations StockOperation[]   @relation("OperationSource")
  destOperations   StockOperation[]   @relation("OperationDest")
  reservations     StockReservation[]

  @@index([warehouseId, locationType])
  @@map("locations")
}

model ProductCategory {
  id               String            @id @default(uuid())
  name             String
  parentCategoryId String?           @map("parent_category_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  parentCategory   ProductCategory?  @relation("CategoryTree", fields: [parentCategoryId], references: [id])
  childCategories  ProductCategory[] @relation("CategoryTree")
  products         Product[]

  @@map("product_categories")
}

model Product {
  id            String             @id @default(uuid())
  name          String
  sku           String             @unique
  barcode       String?            @unique
  categoryId    String?            @map("category_id")
  unitOfMeasure String             @default("pcs") @map("unit_of_measure")
  trackingType  String             @default("none") @map("tracking_type")
  imageUrl      String?            @map("image_url")
  reorderMin    Int                @default(0) @map("reorder_min")
  reorderMax    Int                @default(0) @map("reorder_max")
  reorderQty    Int                @default(0) @map("reorder_qty")
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  category      ProductCategory?   @relation(fields: [categoryId], references: [id])
  lots          ProductLot[]
  moves         StockMove[]
  reservations  StockReservation[]
  reorderRules  ReorderRule[]
  alerts        Alert[]

  @@index([categoryId])
  @@map("products")
}

model ProductLot {
  id               String      @id @default(uuid())
  productId        String      @map("product_id")
  lotNumber        String      @map("lot_number")
  expiryDate       DateTime?   @map("expiry_date")
  manufacturedDate DateTime?   @map("manufactured_date")
  notes            String?
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  moves            StockMove[]

  @@unique([productId, lotNumber])
  @@map("product_lots")
}

model Partner {
  id         String           @id @default(uuid())
  name       String
  type       String
  email      String?
  phone      String?
  address    String?
  isActive   Boolean          @default(true) @map("is_active")
  createdAt  DateTime         @default(now()) @map("created_at")
  operations StockOperation[]

  @@map("partners")
}

model StockOperation {
  id                    String             @id @default(uuid())
  referenceCode         String             @unique @map("reference_code")
  operationType         String             @map("operation_type")
  status                String             @default("draft")
  sourceLocationId      String             @map("source_location_id")
  destinationLocationId String             @map("destination_location_id")
  partnerId             String?            @map("partner_id")
  scheduledDate         DateTime           @default(now()) @map("scheduled_date")
  completedDate         DateTime?          @map("completed_date")
  createdById           String?            @map("created_by")
  assignedToId          String?            @map("assigned_to")
  approvedById          String?            @map("approved_by")
  notes                 String?
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  sourceLocation        Location           @relation("OperationSource", fields: [sourceLocationId], references: [id])
  destinationLocation   Location           @relation("OperationDest", fields: [destinationLocationId], references: [id])
  partner               Partner?           @relation(fields: [partnerId], references: [id])
  createdBy             User?              @relation("OperationCreator", fields: [createdById], references: [id])
  approvedBy            User?              @relation("OperationApprover", fields: [approvedById], references: [id])
  assignedTo            User?              @relation("OperationAssigned", fields: [assignedToId], references: [id])
  moves                 StockMove[]
  reservations          StockReservation[]

  @@index([status, operationType, scheduledDate])
  @@map("stock_operations")
}

model StockMove {
  id                    String         @id @default(uuid())
  operationId           String         @map("operation_id")
  productId             String         @map("product_id")
  lotId                 String?        @map("lot_id")
  quantity              Float
  unitOfMeasure         String         @default("pcs") @map("unit_of_measure")
  sourceLocationId      String         @map("source_location_id")
  destinationLocationId String         @map("destination_location_id")
  status                String         @default("draft")
  createdAt             DateTime       @default(now()) @map("created_at")
  operation             StockOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  product               Product        @relation(fields: [productId], references: [id])
  lot                   ProductLot?    @relation(fields: [lotId], references: [id])
  sourceLocation        Location       @relation("MoveSource", fields: [sourceLocationId], references: [id])
  destinationLocation   Location       @relation("MoveDest", fields: [destinationLocationId], references: [id])

  @@index([productId, destinationLocationId, status])
  @@index([operationId, status])
  @@map("stock_moves")
}

model StockReservation {
  id               String         @id @default(uuid())
  productId        String         @map("product_id")
  locationId       String         @map("location_id")
  lotId            String?        @map("lot_id")
  quantityReserved Float          @map("quantity_reserved")
  operationId      String         @map("operation_id")
  reservedById     String         @map("reserved_by")
  reservedAt       DateTime       @default(now()) @map("reserved_at")
  expiresAt        DateTime       @map("expires_at")
  status           String         @default("active")
  product          Product        @relation(fields: [productId], references: [id])
  location         Location       @relation(fields: [locationId], references: [id])
  operation        StockOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  reservedBy       User           @relation(fields: [reservedById], references: [id])

  @@index([productId, locationId, status])
  @@map("stock_reservations")
}

model ReorderRule {
  id          String    @id @default(uuid())
  productId   String    @map("product_id")
  warehouseId String    @map("warehouse_id")
  minQty      Int       @map("min_qty")
  maxQty      Int       @map("max_qty")
  reorderQty  Int       @map("reorder_qty")
  isActive    Boolean   @default(true) @map("is_active")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@map("reorder_rules")
}

model Alert {
  id          String     @id @default(uuid())
  type        String
  productId   String?    @map("product_id")
  warehouseId String?    @map("warehouse_id")
  message     String
  priority    String     @default("medium")
  isRead      Boolean    @default(false) @map("is_read")
  createdAt   DateTime   @default(now()) @map("created_at")
  product     Product?   @relation(fields: [productId], references: [id])
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([isRead, priority])
  @@map("alerts")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  reason     String?
  ipAddress  String?  @map("ip_address")
  timestamp  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([entityType, entityId, timestamp])
  @@index([userId, timestamp])
  @@map("audit_log")
}